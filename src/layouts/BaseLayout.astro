---
const {
  title = 'Research — Preprints',
  description = 'Preprints',
  pageType = 'website',
  authors = [],
  dateISO = null,
  pdfUrl = null,
  keywords = [],
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://research.vyde.dev';
const pagePath = Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(pagePath === '' ? '/' : pagePath, Astro.site).href;
const pdfAbsolute = pdfUrl ? new URL(pdfUrl, Astro.site).href : null;
const dateSlash = dateISO ? dateISO.replace(/-/g, '/') : null;

const scholarMeta = pageType === 'article' && authors.length > 0;
const jsonLd = pageType === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: title.split(' — ')[0],
  author: authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: dateISO ?? undefined,
  url: canonical,
  mainEntityOfPage: canonical,
  ...(pdfAbsolute ? { encoding: pdfAbsolute } : {}),
  ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
  ...(description ? { description } : {}),
  publisher: { '@type': 'Organization', name: 'Research — Preprints', url: siteUrl },
  isPartOf: { '@type': 'WebSite', name: 'Research — Preprints', url: siteUrl },
} : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Research — Preprints" />
    <meta property="og:locale" content="en_US" />
    {dateISO && pageType === 'article' && <meta property="article:published_time" content={dateISO} />}
    {authors.map((name) => <meta property="article:author" content={name} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Scholar / academic citation -->
    {scholarMeta && <meta name="citation_title" content={title.split(' — ')[0]} />}
    {scholarMeta && authors.map((name) => <meta name="citation_author" content={name} />)}
    {scholarMeta && dateSlash && <meta name="citation_date" content={dateSlash} />}
    {scholarMeta && dateISO && <meta name="citation_online_date" content={dateISO} />}
    {scholarMeta && pdfAbsolute && <meta name="citation_pdf_url" content={pdfAbsolute} />}
    {scholarMeta && <meta name="citation_abstract_html_url" content={canonical} />}
    {scholarMeta && <meta name="citation_journal_title" content="Research — Preprints" />}
    {scholarMeta && <meta name="citation_language" content="en" />}
    {keywords.map((k) => <meta name="citation_keywords" content={k} />)}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />
    <style>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; overflow-x: hidden; }
      body {
        font-family: Georgia, "Times New Roman", serif;
        color: #1a1a1a; max-width: 760px; margin: 2.5rem auto; padding: 0 1.25rem;
        line-height: 1.55; overflow-x: hidden; min-width: 0;
      }
      h1 { font-size: 1.7rem; line-height: 1.25; overflow-wrap: anywhere; word-break: break-word; }
      h2 { font-size: 1.3rem; margin-top: 2rem; }
      a { color: #1f4e9c; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .meta, .small { color: #555; font-size: .95em; }
      .muted { color: #666; }
      .abstract { font-style: italic; }
      .article, .paper { margin-bottom: 2.5rem; }
      .paper { border-bottom: 1px solid #ddd; padding-bottom: 1.5rem; }
      .actions { margin: 1rem 0; display: flex; gap: .5rem; flex-wrap: wrap; }
      .btn {
        display: inline-block; padding: .4rem .9rem; border: 1px solid #1f4e9c;
        border-radius: 4px; color: #1f4e9c; font-size: .95em; background: transparent;
        cursor: pointer;
      }
      .btn.primary { background: #1f4e9c; color: #fff; }
      .tag {
        display: inline-block; background: #eef2f8; border-radius: 10px;
        padding: .05rem .6rem; margin: .1rem .2rem; font-size: .85em;
      }
      .cite {
        border: 1px solid #ddd; border-radius: 6px; padding: .8rem 1rem;
        margin: 1.5rem 0; background: #fafafa; max-width: 100%; overflow: hidden; min-width: 0;
      }
      .cite .row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; min-width: 0; }
      .cite .row button { flex-shrink: 0; }
      .snippet { max-width: 100%; min-width: 0; }
      .snippet pre {
        margin: .5rem 0 0; padding: 0; white-space: pre-wrap; overflow-wrap: anywhere;
        word-break: break-word; max-width: 100%; min-width: 0; overflow: visible;
      }
      .snippet code {
        display: block; width: 100%; white-space: pre-wrap; overflow-wrap: anywhere;
        word-break: break-word; max-width: 100%; min-width: 0;
      }
      .cite pre { white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; margin: .5rem 0 0; max-width: 100%; min-width: 0; overflow: visible; }
      code { font-size: .9em; overflow-wrap: anywhere; word-break: break-word; }
      .body p { text-align: justify; }
      .katex-display { overflow-x: auto; overflow-y: hidden; max-width: 100%; }
      .katex { max-width: 100%; overflow-wrap: anywhere; }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <!-- KaTeX: render $...$ and $$...$$ in the page body -->
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
      onload="window.addEventListener('DOMContentLoaded', function () { renderMathInElement(document.body, { delimiters: [{ left: '$$', right: '$$', display: true }, { left: '$', right: '$', display: false }], throwOnError: false }); });"></script>
  </body>
</html>
